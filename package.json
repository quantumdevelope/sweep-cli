{
  "name": "sweep-cli",
  "version": "0.1.0",
  "description": "Find clutter in your project: duplicate files, empty files, temp/backup leftovers and oversized artifacts. Zero-dependency Node CLI.",
  "type": "module",
  "bin": {
    "sweep": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cli",
    "duplicates",
    "cleanup",
    "disk",
    "gitignore",
    "typescript"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
